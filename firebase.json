{
  "firestore": [
    {
      "database": "bookshelf",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "site": "bookshelf-489820",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
