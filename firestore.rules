rules_version = '2';

// Only my own Google accounts can read or write, each only under its own uid.
// Anyone else who signs in sees an empty app and gets permission-denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/books/{bookId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email in ["mightyoakcoder@gmail.com", "rsnow721@gmail.com"]
        && request.auth.token.email_verified == true;
    }
  }
}
